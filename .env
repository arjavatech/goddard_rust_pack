# ====================
# Application Configuration
# ====================
NODE_ENV=development
PORT=3000
API_PORT=8080
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# ====================
# Authentication & Security
# ====================
