FILLOUT_WEBHOOK_SECRET=your_fillout_webhook_secret

# ====================
# Email Configuration
# ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@goddardschool.com

# ====================
# File Upload & Storage
# ====================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,doc,docx,jpg,jpeg,png
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=goddard-documents

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ====================
# Logging
# ====================
LOG_LEVEL=info
LOG_FORMAT=combined
RUST_LOG=info
DEBUG=goddard:*