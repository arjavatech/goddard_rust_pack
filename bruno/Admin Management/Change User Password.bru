meta {
  name: Change User Password
  type: http
  seq: 6
}

post {
  url: {{base_url}}/users/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "user@example.com",
    "new_password": "NewSecure123"
  }
}

vars:pre-request {
  user_email: user@example.com
  new_password: NewSecure123
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.success: eq true
}

script:post-response {
  if (res.status === 200) {
    console.log("Password updated successfully for", res.body.data.email);
  }
}

docs {
  # Change User Password

  Forcibly sets a user's password by email. Password is updated directly in Supabase Auth. Minimum 8 characters required.

  **Authentication**: JWT Bearer Token (SuperAdmin role required)

  **Request Body**:
  - `email` (string, required) - User's email address
  - `new_password` (string, required) - New password (minimum 8 characters)

  **Response 200 OK**:
  ```json
  {
    "success": true,
    "data": {
      "email": "user@example.com",
      "success": true,
      "message": "Password updated successfully."
    },
    "timestamp": "2026-09-18T12:34:56Z"
  }
  ```

  **Error 400 - Password Too Short**:
  ```json
  {
    "success": false,
    "error": "Password must be at least 8 characters long"
  }
  ```

  **Error 404 - User Not Found**:
  ```json
  {
    "success": false,
    "error": "User not found"
  }
  ```

  **Notes**:
  - No confirmation email is sent to the user
  - SuperAdmin should notify the user separately if needed
  - User can immediately log in with the new password
}
