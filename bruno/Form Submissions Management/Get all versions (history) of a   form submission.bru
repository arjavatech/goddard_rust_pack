meta {
  name: Get all versions (history) of a   form submission
  type: http
  seq: 2
}

get {
  url: {{base_url}}/form-submissions/versions?school_id={{school_id}}&enrollment_id={{enrollment_id}}&form_template_id={{form_template_id}}
  body: none
  auth: inherit
}

params:query {
  school_id: {{school_id}}
  enrollment_id: {{enrollment_id}}
  form_template_id: {{form_template_id}}
}

headers {
  X-API-Key: {{api_key}}
}

settings {
  encodeUrl: true
}
