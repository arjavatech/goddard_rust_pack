meta {
  name: Parent Details Page
  type: http
  seq: 2
}

get {
  url: http://localhost:9000/parent/details?school_id={{school_id}}
  body: none
  auth: inherit
}

params:query {
  school_id: {{school_id}}
}

headers {
  X-API-Key: {{api_key}}
  ~Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
}
