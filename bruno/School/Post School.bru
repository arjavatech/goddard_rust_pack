meta {
  name: Post School
  type: http
  seq: 2
}

post {
  url: {{base_url}}/schools
  body: json
  auth: inherit
}

headers {
  X-API-Key: {{api_key}}
}

body:json {
  {
        "name": "Goddard Schools, Lynnwood",
        "subdomain": "lynnwood",
        "settings": {
          "timezone": "America/New_York",
          "enrollment_capacity": 200,
          "age_groups": ["infants", "toddlers", "preschool", "pre-k"]
  }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
