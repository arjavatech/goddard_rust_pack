meta {
  name: Post School
  type: http
  seq: 2
}

post {
  url: {{base_url}}/schools
  body: json
  auth: inherit
}

headers {
  X-API-Key: {{api_key}}
}

body:json {
  {
    "name": "Goddard Schools, Lynnwood",
    "subdomain": "lynnwood",
    "parent_management_enabled": true,
    "employee_management_enabled": true,
    "expense_management_enabled": false,
    "taptime_enabled": true,
    "conference_enabled": false,
    "survey_enabled": false,
    "drive_enabled": true,
    "settings": {
      "timezone": "America/New_York",
      "enrollment_capacity": 200,
      "age_groups": ["infants", "toddlers", "preschool", "pre-k"],
      "website_url": "https://www.goddardschool.com/lynnwood"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
