meta {
  name: School Create with Owner
  type: http
  seq: 5
}

post {
  url: {{base_url}}/schools/with-owner
  body: json
  auth: inherit
}

headers {
  X-API-Key: {{api_key}}
}

body:json {
  {                                                                                                                      
      "school": {                                                                                                        
        "name": "Goddard Schools, Lynnwood",
        "subdomain": "lynnwood",                                                                                           
        "settings": {
          "timezone": "America/New_York",                                                                                  
          "enrollment_capacity": 200,                     
          "age_groups": ["infants", "toddlers", "preschool", "pre-k"]                                                      
        }
      },                                                                                                                   
      "owner": {                                          
        "email": "karthi.arjava@gmail.com",
        "first_name": "Lynnwood",                                                                                          
        "last_name": "Admin",
        "phone_number": "+1-555-123-4567"                                                                                  
      }                                                   
    }
}

settings {
  encodeUrl: true
  timeout: 0
}
