meta {
  name: Update School
  type: http
  seq: 2
}

put {
  url: {{base_url}}/schools
  body: json
  auth: inherit
}

headers {
  X-API-Key: {{api_key}}
}

body:json {
  {
    "id": "f5cf4539-d3ab-45d4-a609-333eff99d5fd",
    "name": "Goddard School Lynn",
    "subdomain": "Lynn",
    "parent_management_enabled": true,
    "employee_management_enabled": true,
    "expense_management_enabled": false,
    "taptime_enabled": true,
    "conference_enabled": false,
    "survey_enabled": false,
    "drive_enabled": true,
    "settings": {
      "age_groups": [
        "infants",
        "toddlers",
        "preschool",
        "pre-k"
      ],
      "enrollment_capacity": 250,
      "timezone": "America/New_York",
      "website_url": "https://www.goddardschool.com/lynn"
    }
  }
}

settings {
  encodeUrl: true
}
