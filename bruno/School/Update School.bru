meta {
  name: Update School
  type: http
  seq: 2
}

put {
  url: {{base_url}}/schools
  body: json
  auth: inherit
}

headers {
  X-API-Key: {{api_key}}
}

body:json {
  {
      "id": "f5cf4539-d3ab-45d4-a609-333eff99d5fd",
