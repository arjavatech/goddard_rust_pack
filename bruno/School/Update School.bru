      "subdomain": "Lynn",
      "settings": {
        "age_groups": [
          "infants",
          "toddlers",
          "preschool",
          "pre-k"
        ],
        "enrollment_capacity": 250,
        "timezone": "America/New_York"
      }}
}

settings {
  encodeUrl: true
}
