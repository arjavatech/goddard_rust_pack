# ❌ WRONG: Do NOT use Session Pooler (Port 5432) for Lambda
# DATABASE_URL=postgresql://postgres.fxsjcrwsnnowlovcnddz:Arjava%402024@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# =============================================================================
# SUPABASE CONFIGURATION
